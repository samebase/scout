+ * the user's refresh tokens still refresh and the provider accounts still map
+ * to the deleted user id. Upstream issue text: "Add deleteUser({ userId }) to
+ * the core component. It deletes every account and session of the user and
+ * every refresh token of those sessions, like deleteUser in the email and
+ * passkey components."
+ *
+ * Delete every account and session of a user, with the refresh tokens of the
+ * sessions. A session has the user id of its account, so the sessions of the
+ * user are the sessions of the accounts. Idempotent.
+ */
+export const deleteUser = mutation({
+    args: { userId: v.string() },
+    returns: v.null(),
+    handler: async (ctx, { userId }) => {
+        const sessions = await ctx.db
+            .query("sessions")
+            .withIndex("by_user", (q) => q.eq("userId", userId))
+            .collect();
+        for (const session of sessions) {
+            await deleteSession(ctx, session._id);
+        }
+        const accounts = await ctx.db
+            .query("accounts")
+            .withIndex("by_user", (q) => q.eq("userId", userId))
+            .collect();
+        for (const account of accounts) {
+            await ctx.db.delete("accounts", account._id);
+        }
+        return null;
+    },
+});
