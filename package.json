{
  "name": "scout-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vp run samebase-scout#dev",
    "dev:primary": "vp run samebase-scout#dev:primary",
    "dev:frontend": "vp run samebase-scout#dev:frontend",
    "dev:worktree": "vp run samebase-scout#dev:worktree",
    "build": "vp run samebase-scout#build",
    "deploy:dev": "vp run samebase-scout#deploy:dev",
    "preview": "vp run samebase-scout#preview",
    "check": "vp check && vp run typecheck && vp test",
    "typecheck": "tsc --project tsconfig.node.json && vp run --filter \"!scout-workspace\" typecheck",
    "test": "vp test",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --report-unused-disable-directives",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.1.1"
}
