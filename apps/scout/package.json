{
  "name": "samebase-scout",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "dev": "node ./scripts/run-context-dev.ts",
    "dev:primary": "node ./scripts/run-primary-dev.ts",
    "dev:frontend": "vp dev",
    "dev:worktree": "node ./scripts/run-worktree-dev.ts",
    "check": "vp check && vp run typecheck && vp test",
    "build": "vp build",
    "deploy": "convex-hosting deploy --build \"pnpm run build\" --dist dist/client --html-handling drop-trailing-slash",
    "deploy:dev": "convex-hosting deploy --dev --build \"pnpm run build\" --dist dist/client --html-handling drop-trailing-slash",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --report-unused-disable-directives",
    "preview": "vp preview",
    "test": "vp test",
    "typecheck": "tsc && vp run typecheck:node && tsc --project convex/tsconfig.json",
    "typecheck:node": "tsc --project tsconfig.node.json"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.81",
    "@ai-sdk/provider": "^4.0.31",
    "@ai-sdk/provider-utils": "^5.0.65",
    "@auth/core": "0.41.3",
    "@convex-dev/agent": "^0.7.8",
    "@convex-dev/ai-sdk-provider": "^0.3.0",
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/r2": "^0.10.4",
    "@convex-dev/react-query": "^0.1.0",
    "@convex-dev/workflow": "^0.4.10",
    "@convex-dev/workpool": "^0.4.14",
    "@polar-sh/sdk": "1.0.2",
    "@samebase/convex-hosting": "^0.14.0",
    "@samebase/convex-hosting-tanstack-start": "^0.11.0",
    "@samebase/sidebars": "^0.1.2",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "ai": "^7.0.148",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.47.0",
    "convex-helpers": "^0.1.128",
    "firecrawl": "^4.50.0",
    "hls.js": "^1.7.3",
    "just-bash": "3.6.0",
    "lucide-react": "^1.61.0",
    "mediabunny": "^1.62.0",
    "openai": "^7.40.0",
    "outdent": "^0.8.0",
    "playwright-core": "^1.64.1",
    "posthog-js": "^1.438.13",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typegpu": "0.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.47",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "0.0.57",
    "dotenv": "^18.0.8",
    "happy-dom": "^21.0.4",
    "shadcn": "^4.22.1",
    "typescript": "~7.0.2",
    "unplugin-typegpu": "0.12.6",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
