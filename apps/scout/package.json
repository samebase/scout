{
  "name": "samebase-scout",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "dev": "node ./scripts/run-context-dev.ts",
    "dev:primary": "node ./scripts/run-primary-dev.ts",
    "dev:frontend": "vp dev",
    "dev:worktree": "node ./scripts/run-worktree-dev.ts",
    "check": "vp check && vp run typecheck && vp test",
    "build": "vp run build:cloudflare",
    "build:app": "vp build",
    "build:cloudflare": "node ./scripts/build-cloudflare.ts",
    "deploy": "node ./scripts/deploy-cloudflare.ts deploy",
    "deploy:convex": "static-hosting deploy --dist ./dist/client --build-command \"pnpm run build:app\"",
    "deploy:preview": "node ./scripts/deploy-cloudflare.ts preview",
    "deploy:dry-run": "node ./scripts/deploy-cloudflare.ts deploy --dry-run",
    "deploy:preview:dry-run": "node ./scripts/deploy-cloudflare.ts preview --dry-run",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --report-unused-disable-directives",
    "preview": "vp preview",
    "test": "vp test",
    "typecheck": "tsc && vp run typecheck:node && tsc --project convex/tsconfig.json",
    "typecheck:node": "tsc --project tsconfig.node.json"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.39",
    "@ai-sdk/provider": "^4.0.8",
    "@ai-sdk/provider-utils": "^5.0.32",
    "@auth/core": "0.41.3",
    "@convex-dev/agent": "^0.7.1",
    "@convex-dev/ai-sdk-provider": "^0.1.0",
    "@convex-dev/auth": "^0.0.94",
    "@convex-dev/r2": "^0.10.2",
    "@convex-dev/static-hosting": "^0.2.1",
    "@convex-dev/workflow": "^0.4.6",
    "@convex-dev/workpool": "^0.4.10",
    "@samebase/sidebars": "^0.1.2",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.34",
    "ai": "^7.0.83",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.123",
    "firecrawl": "^4.38.0",
    "hls.js": "^1.7.1",
    "just-bash": "3.4.2",
    "lucide-react": "^1.34.0",
    "mediabunny": "^1.55.6",
    "openai": "^7.15.0",
    "outdent": "^0.8.0",
    "playwright-core": "^1.62.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typegpu": "0.12.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "convex-test": "^0.0.56",
    "dotenv": "^17.4.2",
    "happy-dom": "^20.12.0",
    "shadcn": "^4.16.1",
    "typescript": "~6.0.2",
    "unplugin-typegpu": "0.12.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.118.0"
  }
}
