{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-05-14",
  "preview_urls": true,
  "assets": {
    "directory": "./dist/client",
    "html_handling": "none",
    // Public pages use build-generated _redirects rewrites. Unknown app routes
    // receive the separate TanStack Start shell at /index.html.
    "not_found_handling": "single-page-application",
  },
}
